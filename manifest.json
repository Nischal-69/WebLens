{
  "manifest_version": 3,
  "name": "WebLens",
  "description": "See what powers the web.",
  "version": "0.1.0",
  "minimum_chrome_version": "111",
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebLens — See what powers the web.",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "core/signals.js",
        "detectors/react.js",
        "detectors/nextjs.js",
        "detectors/vue.js",
        "detectors/nuxt.js",
        "detectors/angular.js",
        "detectors/svelte.js",
        "detectors/astro.js",
        "detectors/jquery.js",
        "detectors/lodash.js",
        "detectors/gsap.js",
        "detectors/threejs.js",
        "detectors/wordpress.js",
        "detectors/woocommerce.js",
        "detectors/shopify.js",
        "detectors/webflow.js",
        "detectors/wix.js",
        "detectors/squarespace.js",
        "detectors/drupal.js",
        "detectors/joomla.js",
        "detectors/ghost.js",
        "detectors/blogger.js",
        "detectors/tailwind.js",
        "detectors/bootstrap.js",
        "detectors/ga.js",
        "detectors/gtm.js",
        "detectors/cloudflare.js",
        "detectors/registry.js",
        "core/engine.js",
        "core/normalize.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
